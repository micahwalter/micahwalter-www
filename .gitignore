# Source images in posts (too large for Git, stored in S3)
# We keep the MDX files and folder structure, but ignore the actual images
content/posts/**/*.jpg
content/posts/**/*.jpeg
content/posts/**/*.png
content/posts/**/*.gif
content/posts/**/*.webp
# Keep everything else (MDX files, etc)
!content/posts/**/index.mdx

