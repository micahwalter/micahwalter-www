{
  "name": "micahwalter-www",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "blog": "./cli/index.js"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/fetch-mastodon.js && node scripts/generate-posts-json.js && node scripts/generate-rss.js && node scripts/generate-sitemap.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "blog": "node cli/index.js",
    "optimize-images": "node scripts/optimize-images.js",
    "copy-images-local": "node scripts/copy-images-local.js",
    "upload-images": "node scripts/upload-images.js",
    "upload-images:www": "node scripts/upload-images.js --profile www",
    "images": "npm run optimize-images && npm run upload-images",
    "images:www": "npm run optimize-images && npm run upload-images:www",
    "images:dev": "npm run optimize-images && npm run copy-images-local"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "date-fns": "^4.1.0",
    "fathom-client": "^3.7.2",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.13.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1004.0",
    "@aws-sdk/credential-providers": "^3.1004.0",
    "@types/node": "^22.19.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cli-progress": "^3.12.0",
    "eslint": "^9",
    "eslint-config-next": "^15.1.6",
    "exifreader": "^4.36.1",
    "p-limit": "^4.0.0",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5"
  }
}
